<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />


    <application
        android:name=".HyperBackgroundApp"
        android:allowBackup="false"
        android:description="@string/app_description"
        android:icon="@drawable/app_icon"
        android:roundIcon="@drawable/app_icon"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 开机自动换随机背景：默认禁用，仅当用户在设置里选了「开机」模式时由
             HyperBackgroundApp 运行时通过 PackageManager 启用，避免仅手动模式下开机被无谓拉起。 -->
        <receiver
            android:name=".BootRandomReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".appearance.SettingsAppearanceProvider"
            android:authorities="com.ciallo.hyperbackground.settingsappearance"
            android:exported="true"
            android:grantUriPermissions="true" />

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="为 HyperOS 系统设置、我的设备等页面注入自定义背景（图片/GIF/视频），支持模糊与透明度调节。" />
        <meta-data android:name="xposedminversion" android:value="101" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
    </application>
</manifest>

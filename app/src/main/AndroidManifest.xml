<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 「软件作用域」要把 LSPosed 里勾选的作用域包名解析成应用名和图标。作用域是动态的，
         可能包含任意第三方应用，也有 com.milink.service、com.miui.powerkeeper 这类没有启动入口的
         系统包，无法用静态 <queries> 覆盖；缺少该权限时 Android 11+ 的包可见性限制会让
         getApplicationInfo 直接抛 NameNotFoundException，导致列表数量和实际作用域对不上。 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />


    <application
        android:name=".HyperBackgroundApp"
        android:allowBackup="false"
        android:description="@string/app_description"
        android:icon="@drawable/app_icon"
        android:roundIcon="@drawable/app_icon"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- MainActivity 只保留 LSPosed 管理器入口（MODULE_SETTINGS）：桌面图标隐藏后仍可从
              LSPosed 管理器进入模块界面，不再依赖启动器入口。 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面图标由 activity-alias 承载：设置里「隐藏桌面图标」只需禁用本别名组件
             （PackageManager.setComponentEnabledSetting），MainActivity 本身不受影响。 -->
        <activity-alias
            android:name=".ui.MainActivityAlias"
            android:targetActivity=".ui.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/app_icon"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 开机自动换随机背景：默认禁用，仅当用户在设置里选了「开机」模式时由
             HyperBackgroundApp 运行时通过 PackageManager 启用，避免仅手动模式下开机被无谓拉起。 -->
        <receiver
            android:name=".BootRandomReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".appearance.SettingsAppearanceProvider"
            android:authorities="com.ciallo.hyperbackground.settingsappearance"
            android:exported="true"
            android:grantUriPermissions="true" />

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="为 HyperOS 系统设置、我的设备等页面注入自定义背景（图片/GIF/视频），支持模糊与透明度调节。" />
        <meta-data android:name="xposedminversion" android:value="101" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
    </application>
</manifest>

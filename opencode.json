{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "Cherry-hinoob": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cherry-hinoob",
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY_HINOOB}",
        "baseURL": "https://cliapi.hinoob.net/v1"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol",
          "reasoning": true,
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  }
}